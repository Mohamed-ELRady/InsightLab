# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Language model provider
# ---------------------------------------------------------------------------
# These are CLI and deployment defaults. In the web app you can select a
# provider, enter a key and test it directly from the sidebar; GUI keys are
# session-only and are never written back to this file.
#
# Supported: groq, google, openrouter, cerebras, xai, openai, anthropic, custom
LLM_PROVIDER=groq

# Provider-native model ID (the app adds the LiteLLM routing prefix).
LLM_MODEL=openai/gpt-oss-120b

# Fill only the variable for the provider selected above.
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_LLM_API_KEY=

# Optional additional keys for the selected provider, tried left to right.
# In the web app, add these from the provider panel instead.
LLM_API_KEYS=

# Required only for a custom OpenAI-compatible endpoint.
LLM_BASE_URL=

# Sampling temperature for agent reasoning. Lower is more deterministic.
LLM_TEMPERATURE=0.2

# Seconds to wait for a single model call before giving up.
LLM_TIMEOUT=60

# Hard completion ceiling. Individual short tasks use smaller limits automatically.
LLM_MAX_OUTPUT_TOKENS=1400

# ---------------------------------------------------------------------------
# Application behaviour
# ---------------------------------------------------------------------------
# Directory where run artefacts (state, cleaned data, reports) are written.
INSIGHTLAB_WORKSPACE=data/runs

# Maximum size of an uploaded file, in megabytes.
MAX_UPLOAD_MB=200

# Number of rows sampled when a preview or a model prompt needs example data.
SAMPLE_ROWS=200

# Set to 1 to disable all model calls and fall back to deterministic heuristics.
# Useful for offline development and for the test suite.
INSIGHTLAB_OFFLINE=0
