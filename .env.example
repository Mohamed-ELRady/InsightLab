# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Language model provider
# ---------------------------------------------------------------------------
# Provider used by every agent. Supported: openai, anthropic, google
LLM_PROVIDER=openai

# Model identifier passed to the provider.
LLM_MODEL=gpt-4o-mini

# API key for the selected provider.
OPENAI_API_KEY=

# Sampling temperature for agent reasoning. Lower is more deterministic.
LLM_TEMPERATURE=0.2

# Seconds to wait for a single model call before giving up.
LLM_TIMEOUT=60

# ---------------------------------------------------------------------------
# Application behaviour
# ---------------------------------------------------------------------------
# Directory where run artefacts (state, cleaned data, reports) are written.
INSIGHTLAB_WORKSPACE=data/runs

# Maximum size of an uploaded file, in megabytes.
MAX_UPLOAD_MB=200

# Number of rows sampled when a preview or a model prompt needs example data.
SAMPLE_ROWS=200

# Set to 1 to disable all model calls and fall back to deterministic heuristics.
# Useful for offline development and for the test suite.
INSIGHTLAB_OFFLINE=0
